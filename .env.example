# =============================================================================
# Sol Perfumes Árabes — Variables de entorno
# =============================================================================
# Copia este archivo a `.env` (desarrollo) y configura cada variable en Vercel
# para producción. La validación de `lib/env.ts` impide arrancar la app si
# falta cualquier variable requerida.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Base de datos (Postgres 16, Neon o Supabase) ----------------------------
# Cadena con pooling para runtime de la app
DATABASE_URL="postgresql://user:password@host:5432/sol_perfumes?sslmode=require&pgbouncer=true"
# Cadena directa para migraciones Prisma
DIRECT_URL="postgresql://user:password@host:5432/sol_perfumes?sslmode=require"

# --- Auth.js v5 ---------------------------------------------------------------
# Genera con: `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (Cloud Console > Credentials > OAuth 2.0)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email magic-link (usa Resend internamente)
AUTH_EMAIL_FROM="Sol Perfumes <hola@solperfumesarabes.com>"

# Admin inicial (creado por seed)
ADMIN_EMAIL="admin@solperfumesarabes.com"
ADMIN_PASSWORD=""

# --- Stripe -------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Resend (email transaccional) --------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="Sol Perfumes <hola@solperfumesarabes.com>"

# --- UploadThing (o Cloudflare R2) -------------------------------------------
UPLOADTHING_TOKEN=""
UPLOADTHING_SECRET=""

# --- Upstash Redis (rate limiting) -------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Meilisearch --------------------------------------------------------------
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# --- Sentry (errores) ---------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Analytics ----------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- Mapas (MapLibre + tiles) -------------------------------------------------
NEXT_PUBLIC_MAPTILER_KEY=""

# --- WhatsApp Business --------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="34600000000"
