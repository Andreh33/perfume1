// =============================================================================
// Sol Perfumes Árabes — Schema Prisma
// =============================================================================
// Postgres 16 · driver-adapters habilitados · soft-delete con deletedAt
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "fullTextSearchPostgres", "relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum Gender {
  MASCULINO
  FEMENINO
  UNISEX
}

enum NoteType {
  SALIDA
  CORAZON
  FONDO
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FairStatus {
  UPCOMING
  ONGOING
  PAST
  CANCELLED
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

// -----------------------------------------------------------------------------
// Auth — modelos de Auth.js v5 + extensiones
// -----------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  emailVerified      DateTime?
  name               String?
  passwordHash       String?
  image              String?
  role               UserRole  @default(CUSTOMER)
  locale             String    @default("es")
  phone              String?

  // 2FA TOTP
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  backupCodes        String[]  @default([])

  // Marketing
  newsletterOptIn    Boolean   @default(false)
  favoriteNoteIds    String[]  @default([])

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  lastLoginAt        DateTime?

  accounts           Account[]
  sessions           Session[]
  addresses          Address[]
  orders             Order[]
  carts              Cart[]
  reviews            Review[]
  wishlist           Wishlist?
  blogPosts          BlogPost[]
  createdFairs       PerfumeFair[]   @relation("FairCreator")
  auditLogs          AuditLog[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// Direcciones
// -----------------------------------------------------------------------------

model Address {
  id          String      @id @default(cuid())
  userId      String
  type        AddressType @default(SHIPPING)
  label       String?
  firstName   String
  lastName    String
  company     String?
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String
  country     String      @default("ES")
  phone       String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Catálogo
// -----------------------------------------------------------------------------

model Collection {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         Json      // { es, en, ar }
  description  Json?     // rich-text JSON i18n
  bannerImage  String?
  position     Int       @default(0)
  isFeatured   Boolean   @default(false)
  metaTitle    Json?
  metaDescription Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  products     Product[]

  @@index([slug])
  @@index([isFeatured])
}

model OlfactiveNote {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        Json           // { es, en, ar }
  description Json?
  icon        String         // ruta a SVG
  color       String?        // OKLCH para chips
  type        NoteType?      // tipo dominante (informativo)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  productNotes ProductNote[]

  @@index([slug])
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            Json          // { es, en, ar }
  shortDescription Json?
  description     Json?         // rich text JSON i18n
  story           Json?         // historia / inspiración
  howToUse        Json?

  gender          Gender        @default(UNISEX)
  family          String        // ej: "oriental_oud"
  perfumer        String?
  origin          String?       // ej: "Dubai, EAU"
  releaseYear     Int?

  isFeatured      Boolean       @default(false)
  isNew           Boolean       @default(false)
  isLimited       Boolean       @default(false)
  isPublished     Boolean       @default(false)

  metaTitle       Json?
  metaDescription Json?
  ogImage         String?

  collectionId    String?
  collection      Collection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  variants        ProductVariant[]
  images          ProductImage[]
  productNotes    ProductNote[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([slug])
  @@index([gender, family])
  @@index([isPublished, isFeatured])
  @@index([collectionId])
  @@index([deletedAt])
}

model ProductVariant {
  id           String    @id @default(cuid())
  productId    String
  sizeMl       Int
  sku          String    @unique
  barcode      String?
  priceCents   Int       // EUR céntimos
  compareAtCents Int?
  weightGrams  Int       @default(150)
  stock        Int       @default(0)
  lowStockAt   Int       @default(3)
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String
  alt          Json     // { es, en, ar }
  blurDataUrl  String?
  width        Int?
  height       Int?
  position     Int      @default(0)
  isCover      Boolean  @default(false)
  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductNote {
  productId String
  noteId    String
  type      NoteType
  position  Int      @default(0)

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  note      OlfactiveNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([productId, noteId, type])
  @@index([noteId])
}

// -----------------------------------------------------------------------------
// Carrito y pedidos
// -----------------------------------------------------------------------------

model Cart {
  id          String     @id @default(cuid())
  userId      String?
  sessionKey  String?    @unique
  currency    String     @default("EUR")
  couponId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  expiresAt   DateTime?

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
  coupon      Coupon?    @relation(fields: [couponId], references: [id])

  @@index([userId])
}

model CartItem {
  id         String         @id @default(cuid())
  cartId     String
  productId  String
  variantId  String
  quantity   Int            @default(1)
  unitPriceCents Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id              String       @id @default(cuid())
  number          String       @unique  // ej: SOL-2026-00001
  userId          String?
  email           String
  status          OrderStatus  @default(PENDING)
  currency        String       @default("EUR")

  subtotalCents   Int
  discountCents   Int          @default(0)
  shippingCents   Int          @default(0)
  taxCents        Int          @default(0)
  totalCents      Int

  // Snapshot direcciones (JSON) — robusto ante cambios futuros
  shippingAddress Json
  billingAddress  Json

  // Stripe
  stripePaymentIntentId String? @unique
  stripeChargeId        String?
  paymentMethod         String?

  couponCode      String?
  couponId        String?

  // Envío
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  notes           String?  @db.Text
  internalNotes   String?  @db.Text

  locale          String   @default("es")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  coupon          Coupon?     @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([number])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  variantId     String?

  // Snapshot — sobreviven a borrados
  productName   String
  variantSku    String
  variantSize   Int
  imageUrl      String?
  unitPriceCents Int
  quantity      Int
  totalCents    Int

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Int        // céntimos para FIXED, basis points (10000 = 100%) para PERCENT
  minSubtotalCents Int       @default(0)
  maxRedemptions  Int?
  redemptions     Int        @default(0)
  firstOrderOnly  Boolean    @default(false)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean    @default(true)
  description     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  carts           Cart[]
  orders          Order[]

  @@index([code])
  @@index([isActive, startsAt, endsAt])
}

// -----------------------------------------------------------------------------
// Reseñas y wishlist
// -----------------------------------------------------------------------------

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String
  rating     Int          // 1..5
  title      String?
  body       String       @db.Text
  images     String[]     @default([])
  status     ReviewStatus @default(PENDING)
  helpful    Int          @default(0)
  verified   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id          String   @id @default(cuid())
  wishlistId  String
  productId   String
  notifyStock Boolean  @default(false)
  createdAt   DateTime @default(now())

  wishlist    Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
}

// -----------------------------------------------------------------------------
// Blog
// -----------------------------------------------------------------------------

model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         Json
  excerpt       Json?
  content       Json       // Tiptap JSON
  cover         String?
  status        BlogStatus @default(DRAFT)
  readingMinutes Int       @default(5)
  tags          String[]   @default([])
  authorId      String
  publishedAt   DateTime?
  metaTitle     Json?
  metaDescription Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  author        User       @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([status, publishedAt])
}

// -----------------------------------------------------------------------------
// Ferias (calendario público)
// -----------------------------------------------------------------------------

model PerfumeFair {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         Json       // { es, en, ar }
  description   Json?      // rich text JSON i18n

  startDate     DateTime
  endDate       DateTime
  timezone      String     @default("Europe/Madrid")
  allDay        Boolean    @default(false)

  city          String
  country       String     @default("ES")
  venue         String?
  address       String?
  lat           Float?
  lng           Float?

  websiteUrl    String?
  ticketUrl     String?

  coverImage    String?
  gallery       String[]   @default([])

  status        FairStatus @default(UPCOMING)
  statusManual  Boolean    @default(false)
  isFeatured    Boolean    @default(false)
  tags          String[]   @default([])

  createdById   String?
  createdBy     User?      @relation("FairCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  @@index([startDate])
  @@index([country, city])
  @@index([status])
  @@index([isFeatured])
  @@index([slug])
}

// -----------------------------------------------------------------------------
// Marketing
// -----------------------------------------------------------------------------

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  locale      String   @default("es")
  consent     Boolean  @default(true)
  consentIp   String?
  source      String?
  unsubscribedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([email])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   // ej: "product.update"
  entity    String   // ej: "Product"
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @unique
  mime      String
  width     Int?
  height    Int?
  bytes     Int?
  alt       Json?
  folder    String?
  uploadedById String?
  createdAt DateTime @default(now())

  @@index([folder])
}
